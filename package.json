{
  "name": "snapshot-annotate",
  "productName": "Snapshot",
  "version": "1.0.1",
  "description": "Cross-platform screenshot tool with region selection and annotation",
  "author": "Yaroslav Yurchenko",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.malse.snapshot",
    "productName": "Snapshot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      { "provider": "github", "releaseType": "release" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Snapshot needs screen recording access to capture screenshots."
      }
    }
  }
}
